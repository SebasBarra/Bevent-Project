{
  "AllowedOrigins": "http://localhost:3000",
  "ConnectionStrings": {
    "Database": "Host=bevent-db;Port=5432;Database=bevent-db;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Clerk": {
    "SecretKey": "sk_test_your_clerk_secret_key_here"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
